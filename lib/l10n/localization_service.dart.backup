enum AppLanguage {
  en('English', 'en', '🇺🇸'),
  it('Italiano', 'it', '🇮🇹'),
}

class AppLanguage {
  final String displayName;
  final String code;
  final String flag;

  const AppLanguage(this.displayName, this.code, this.flag);
}

class AppLocalizations {
