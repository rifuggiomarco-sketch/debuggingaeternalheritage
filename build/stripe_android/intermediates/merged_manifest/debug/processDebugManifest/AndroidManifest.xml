<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.flutter.stripe" >

    <uses-sdk android:minSdkVersion="21" />

    <application>
        <activity
            android:name="com.reactnativestripesdk.CustomPaymentMethodActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.StripeReactNative.Transparent" />

        <!-- Interceptor for stripe-connect:// deep links -->
        <activity
            android:name="com.reactnativestripesdk.StripeConnectDeepLinkInterceptorActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="stripe-connect" />
            </intent-filter>
        </activity>

        <provider
            android:name="com.reactnativestripesdk.StripeFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>