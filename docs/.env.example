# Digital Vault Heritage v3.0 - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_NAME=Digital Vault Heritage
APP_VERSION=3.0.0
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_LOG_LEVEL=debug

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Encryption settings
ENCRYPTION_ITERATIONS=100000
ENCRYPTION_SALT_LENGTH=16
ENCRYPTION_KEY_LENGTH=32

# Session management
SESSION_TIMEOUT_HOURS=24
SESSION_MAX_AGE_DAYS=7

# Rate limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
MAX_PIN_ATTEMPTS=5
PIN_ATTEMPT_WINDOW_MINUTES=10
MAX_RECOVERY_ATTEMPTS=3
RECOVERY_ATTEMPT_WINDOW_HOURS=1

# =============================================================================
# STRIPE PAYMENT CONFIGURATION
# =============================================================================
# Stripe API Keys (get these from your Stripe dashboard)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_PRICE_PREMIUM_MONTHLY=price_1premium_monthly
STRIPE_PRICE_PREMIUM_YEARLY=price_1premium_yearly
STRIPE_PRICE_LIFETIME=price_1lifetime

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
# Get these from your Firebase project settings
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# =============================================================================
# NOTIFICATION SERVICES
# =============================================================================
# Email service configuration
EMAIL_SERVICE_ENDPOINT=https://api.your-email-service.com
EMAIL_SERVICE_API_KEY=your-email-service-api-key
EMAIL_FROM_ADDRESS=noreply@digitalvault.com
EMAIL_FROM_NAME=Digital Vault Heritage

# SMS service configuration
SMS_SERVICE_ENDPOINT=https://api.your-sms-service.com
SMS_SERVICE_API_KEY=your-sms-service-api-key
SMS_FROM_NUMBER=+1234567890

# Push notification service
PUSH_SERVICE_ENDPOINT=https://api.your-push-service.com
PUSH_SERVICE_API_KEY=your-push-service-api-key

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# For future database integration
DATABASE_URL=postgresql://username:password@localhost:5432/digital_vault
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT_SECONDS=30

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Dead Man's Switch services
DEAD_MANS_SWITCH_WEBHOOK_URL=https://api.your-service.com/webhook
DEAD_MANS_SWITCH_BACKUP_URL=https://backup-api.your-service.com

# Security logging service
SECURITY_LOG_ENDPOINT=https://api.your-security-service.com/logs
SECURITY_LOG_API_KEY=your-security-log-api-key

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Enable/disable features for development
ENABLE_FEATURE_FLAGS=true
ENABLE_DEBUG_MODE=true
ENABLE_MOCK_SERVICES=true
ENABLE_TEST_MODE=false

# =============================================================================
# PRODUCTION CONFIGURATION (override these in production)
# =============================================================================
# Production environment variables should be set in your hosting platform
# These are defaults for production deployment

# Production security (more strict)
PRODUCTION_ENCRYPTION_ITERATIONS=200000
PRODUCTION_SESSION_TIMEOUT_HOURS=12
PRODUCTION_MAX_LOGIN_ATTEMPTS=3

# Production logging
PRODUCTION_LOG_LEVEL=warning
PRODUCTION_ENABLE_DEBUG_MODE=false
PRODUCTION_ENABLE_MOCK_SERVICES=false

# Production monitoring
PRODUCTION_ENABLE_CRASH_REPORTING=true
PRODUCTION_ENABLE_ANALYTICS=true
PRODUCTION_ENABLE_PERFORMANCE_MONITORING=true

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# Test environment variables
TEST_ENCRYPTION_ITERATIONS=1000
TEST_SESSION_TIMEOUT_MINUTES=5
TEST_ENABLE_MOCK_SERVICES=true
TEST_DATABASE_URL=sqlite::memory:

# =============================================================================
# LOCAL DEVELOPMENT
# =============================================================================
# Local development settings
LOCAL_SERVER_PORT=8080
LOCAL_ENABLE_HOT_RELOAD=true
LOCAL_ENABLE_DEBUG_CONSOLE=true

# =============================================================================
# COMPLIANCE & LEGAL
# =============================================================================
# GDPR and compliance settings
ENABLE_GDPR_COMPLIANCE=true
ENABLE_DATA_RETENTION=true
DATA_RETENTION_DAYS=365
ENABLE_AUDIT_LOGGING=true

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
# Error tracking
SENTRY_DSN=your-sentry-dsn
ENABLE_ERROR_TRACKING=true

# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
ENABLE_ANALYTICS_TRACKING=true

# Performance monitoring
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=0.1

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================
# Backup configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true

# Recovery settings
ENABLE_EMERGENCY_RECOVERY=true
EMERGENCY_CONTACT_EMAIL=emergency@digitalvault.com

# =============================================================================
# API CONFIGURATION
# =============================================================================
# API settings
API_VERSION=v3
API_RATE_LIMIT_REQUESTS_PER_MINUTE=100
API_TIMEOUT_SECONDS=30
ENABLE_API_CACHING=true

# CORS settings
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable specific features
ENABLE_DEAD_MANS_SWITCH=true
ENABLE_CONDITIONAL_INHERITANCE=true
ENABLE_MULTI_CHANNEL_CHECKIN=true
ENABLE_GRACE_PERIOD=true
ENABLE_USER_REPORTING=true
ENABLE_ADVANCED_LOGGING=true

# Beta features
ENABLE_BETA_FEATURES=false
ENABLE_EXPERIMENTAL_FEATURES=false

# =============================================================================
# MAINTENANCE & OPERATIONS
# =============================================================================
# Maintenance mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System under maintenance. Please try again later.

# Health checks
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL_MINUTES=5

# =============================================================================
# LEGAL & PRIVACY
# =============================================================================
# Privacy policy
PRIVACY_POLICY_URL=https://digitalvault.com/privacy
TERMS_OF_SERVICE_URL=https://digitalvault.com/terms

# Cookie consent
ENABLE_COOKIE_CONSENT=true
COOKIE_CONSENT_VERSION=1.0

# =============================================================================
# BUILD & DEPLOYMENT
# =============================================================================
# Build configuration
BUILD_NUMBER=1
BUILD_DATE=2024-05-05
COMMIT_HASH=abcd1234

# Deployment
DEPLOY_ENVIRONMENT=development
DEPLOY_REGION=us-west-2
DEPLOY_VERSION=3.0.0
